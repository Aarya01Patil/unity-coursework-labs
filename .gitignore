# ==============================================================================
# Unity .gitignore for Coursework & Labs Monorepo
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Separate existing submission repository
Submission/

# Unity generated caches and temporary files (match any subproject)
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Aa]ssets/[Aa]ssetStoreTools*

# Crash reports & auto-generated files
**/sysinfo.txt
**/*.stackdump

# Builds inside projects (allow root builds/ folder)
**/06-soul-sucker-gamejam/[Bb]uilds/
**/[Bb]uild/
**/[Bb]uilds/

# Explicitly keep the exported web builds in the root builds/ folder
!builds/
!builds/**

# Visual Studio / Rider / VS Code cache & solutions
**/.vs/
**/.vscode/
**/.idea/
**/*.csproj
**/*.unityproj
**/*.sln
**/*.slnx
**/*.suo
**/*.user
**/*.userprefs
**/*.pidb
**/*.booproj
**/*.svd
**/*.pdb
**/*.mdb
**/*.opendb
**/*.VC.db

# Unity profiler & asset serialization
**/*.pidb.meta
**/*.pdb.meta
**/*.mdb.meta
